{
  "name": "costa-clara",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"*.{ts,json}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "data:import": "tsx scripts/import-data.ts",
    "data:example": "tsx scripts/import-data.ts --input data/raw/example --output data/generated/example.ts",
    "sitemap:generate": "tsx scripts/generate-sitemap.ts",
    "deploy": "npm run build && wrangler pages deploy dist/costa-clara/browser --project-name costa-clara --branch main",
    "storybook": "ng run costa-clara:storybook",
    "build-storybook": "ng run costa-clara:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "ol": "^10.11.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular-devkit/architect": "^0.2203.0",
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular-devkit/core": "^22.3.0",
    "@angular/animations": "^22.3.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/angular-vite": "^10.6.9",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.7",
    "angular-eslint": "^22.8.0",
    "csv-parse": "^7.0.3",
    "eslint": "^10.15.0",
    "eslint-plugin-storybook": "^10.6.9",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "storybook": "^10.6.9",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "latest",
    "vitest": "^5.0.0",
    "wrangler": "^4.168.0"
  }
}
